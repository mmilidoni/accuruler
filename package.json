{
  "name": "accuruler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Measure any element on any background. MV3 cross-browser extension (Chrome/Edge/Firefox).",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run build",
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/generate-icons.ps1",
    "smoke": "node scripts/smoke-test.mjs",
    "build:test": "node scripts/build-test.mjs",
    "test:measure": "node scripts/measure-test.mjs",
    "test:p2": "node scripts/p2-test.mjs",
    "lint:amo": "web-ext lint --source-dir dist",
    "package": "node scripts/package.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "release": "npm run check && npm run lint:amo && npm run package"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/webextension-polyfill": "^0.12.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "web-ext": "^10.6.0"
  }
}
